  "type": "module",
  "scripts": {
    "dev": "concurrently -n web,api,inference -c blue,green,magenta \"npm:dev:web\" \"npm:dev:api\" \"npm:dev:inference\"",
    "dev:web": "vite",
    "dev:api": "tsx watch server/src/index.ts",
    "dev:inference": "cd inference && .venv\\Scripts\\python -m uvicorn app.main:app --host 127.0.0.1 --port 8001",
    "seed:demo": "tsx server/src/seed-cli.ts",
    "build": "tsc -b && vite build",
    "typecheck:server": "tsc -p server/tsconfig.json",
    "test": "vitest run",
    "test:inference": "cd inference && .venv\\Scripts\\python -m pytest -q",
    "lint": "eslint .",
    "preview": "vite preview"
  },
