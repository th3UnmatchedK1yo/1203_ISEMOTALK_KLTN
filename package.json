{
  "name": "1203_kltn",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n web,api,inference -c blue,green,magenta \"npm:dev:web\" \"npm:dev:api\" \"npm:dev:inference\"",
    "dev:web": "vite",
    "dev:api": "tsx watch server/src/index.ts",
    "dev:inference": "node scripts/run-python.mjs -m uvicorn app.main:app --host 127.0.0.1 --port 8001",
    "start:api": "node --import tsx server/src/index.ts",
    "demo": "node scripts/start-demo.mjs",
    "demo:check": "node scripts/check-demo.mjs",
    "demo:warmup": "node scripts/check-demo.mjs --warmup-asr",
    "db:check": "node --import tsx server/src/db-check.ts",
    "db:report": "node --import tsx server/src/db-check.ts --json",
    "seed:demo": "tsx server/src/seed-cli.ts",
    "build": "tsc -b && vite build",
    "typecheck:server": "tsc -p server/tsconfig.json",
    "test": "vitest run",
    "test:inference": "node scripts/run-python.mjs -m unittest discover -s tests -p test_*.py -v",
    "lint": "eslint .",
    "preview": "vite preview",
    "remote:preflight": "node scripts/check-remote-server.mjs",
    "remote:server": "node scripts/start-remote-server.mjs",
    "remote:check": "node scripts/check-remote-models.mjs",
    "remote:web": "node scripts/start-remote-web.mjs",
    "remote:smoke": "node scripts/remote-real-smoke.mjs",
    "remote:qa-smoke": "node scripts/remote-qa-smoke.mjs",
    "remote:api-preview": "node scripts/start-remote-api-preview.mjs",
    "remote:web:preview": "node scripts/start-remote-web.mjs --preview",
    "remote:mvp-check": "node scripts/check-remote-mvp.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@radix-ui/react-avatar": "^1.1.0",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-select": "^2.1.0",
    "@radix-ui/react-slot": "^1.1.0",
    "@radix-ui/react-tabs": "^1.1.0",
    "@tanstack/react-query": "^5.105.1",
    "better-sqlite3": "^11.10.0",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "cors": "^2.8.6",
    "csv-parse": "^7.0.3",
    "csv-stringify": "^6.9.0",
    "express": "^5.3.0",
    "lucide-react": "^0.436.0",
    "multer": "^2.5.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.0",
    "recharts": "^2.12.7",
    "tailwind-merge": "^2.5.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@types/supertest": "^7.2.1",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "concurrently": "^10.0.6",
    "postcss": "^8.4.41",
    "supertest": "^7.3.1",
    "tailwindcss": "^3.4.10",
    "tsx": "^4.23.15",
    "typescript": "~5.5.4",
    "vite": "^5.4.2",
    "vitest": "^2.1.9"
  },
  "allowScripts": {
    "better-sqlite3@11.10.0": true,
    "esbuild@0.21.5": true,
    "esbuild@0.28.2": true
  }
}
