# Copy to inference/.env only after checking dependencies and disk space.
# These are EXAMPLES, not instructions to enable unverified inference.
ISEMO_MODE=mock
ISEMO_ASR=mock
ISEMO_SER=mock
ISEMO_DIARIZATION=none
ISEMO_ASR_MODEL=vinai/PhoWhisper-small
ISEMO_ASR_DEVICE=auto

# Cache-first ASR option: does not require torch and uses local model only.
# ISEMO_ASR=faster_whisper
# ISEMO_ASR_MODEL=Systran/faster-whisper-small
# ISEMO_ASR_DEVICE=cpu
#
# After restoring the exact research checkpoint and preprocessing code:
# ISEMO_SER=checkpoint
# ISEMO_SER_FACTORY=your_package.serving:build_model
# ISEMO_SER_CONFIG=C:/path/to/private/ser_config.json
# ISEMO_ALLOW_UNVERIFIED=0
